# Staging .env template. Copy to `.env` in the staging checkout's project root
# (one level above `public/`, so it is outside the document root) and fill in
# the two blanks. Everything else already has a safe default (.env.example
# documents each one) — this file only overrides what staging needs to differ
# on: a real HTTPS URL and page caching turned on like production will be.

SITE_URL=https://REPLACE-WITH-STAGING-SUBDOMAIN
APP_ENV=prod
DB_PATH=data/site.sqlite
CACHE_DIR=cache
CACHE_TTL=3600

# Leave the rest (SMTP, VenderCRM, Mailchimp, GA4) empty on staging — no lead
# emails or CRM pushes should fire from a non-production URL. Fill only:
WHATSAPP_NUMBER=595995628862
LEAD_EMAIL_TO=hello@thingstodoinparaguay.com
