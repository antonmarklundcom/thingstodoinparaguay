# Copy to .env and fill in. Nothing here is required for local development —
# every value has a safe default and the site degrades gracefully without it.

# Absolute or site-root-relative base URL, no trailing slash.
SITE_URL=http://localhost:8080

# Environment: dev | prod. `dev` turns the HTML page cache off by default.
APP_ENV=dev

# SQLite database file (relative paths resolve from the project root).
DB_PATH=data/site.sqlite

# HTML page cache directory and TTL in seconds (0 disables the cache).
# Leave CACHE_TTL empty to take the default: 0 when APP_ENV=dev, 3600 otherwise.
CACHE_DIR=cache
CACHE_TTL=

# --- Optional integrations (phase S3 uses these; absence is never an error) ---

# Lead notification email + SMTP. Without SMTP_HOST, PHP mail() is used; if that
# fails the lead is still stored in SQLite.
LEAD_EMAIL_TO=hello@thingstodoinparaguay.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# VenderCRM lead push (skill: vendercrm-lead-capture). Empty = push disabled.
VENDERCRM_ENDPOINT=
VENDERCRM_API_KEY=

# Mailchimp newsletter. Empty = subscribers are stored locally only.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# GA4 measurement id, e.g. G-XXXXXXXXXX. Empty = no analytics script.
GA4_ID=

# WhatsApp number in wa.me form (digits only).
WHATSAPP_NUMBER=595995628862
